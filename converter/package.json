{"bin":{"prism2hlx":"src/cli.ts"},"dependencies":{"jszip":"^3.10.1"},"description":"Standalone Prism 10 (.prism) → Helix (.hlx) converter CLI. Built on the side, in parallel with the analysis loop; the hook-up into the Helix app comes later.","devDependencies":{"@types/node":"^24.19.2","tsx":"^4.23.15","typescript":"^5.5.3"},"license":"GPL-3.0-or-later","name":"helix-converter","private":true,"scripts":{"check":"tsc --noEmit -p tsconfig.json","convert":"node --import tsx src/cli.ts","verify":"node --import tsx tests/verify.ts","verify-corpus":"node --import tsx tests/verify-corpus.ts","make-synthetic":"node --import tsx tests/make-synthetic.ts"},"type":"module","version":"0.1.0"}