{
  "name": "titer",
  "version": "1.0.7",
  "description": "Scientific data analysis, simplified — an open-source alternative to GraphPad Prism.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "./scripts/build-webr-repo.sh && tauri build --target aarch64-apple-darwin && tauri build --target x86_64-apple-darwin",
    "build:linux": "./scripts/build-webr-repo.sh && tauri build --no-bundle",
    "install-app": "tauri build --bundles app && rm -rf /Applications/Titer.app && ditto src-tauri/target/release/bundle/macos/Titer.app /Applications/Titer.app",
    "web": "vite",
    "check": "tsc --noEmit",
    "e2e:build": "VITE_E2E=1 npx tauri build --debug --no-bundle",
    "e2e": "wdio run e2e/wdio.conf.js",
    "sample": "node --import tsx tests/sample-project.ts",
    "test": "node --import tsx tests/checks.ts && node --import tsx tests/prism.ts && node --import tsx tests/prism-write.ts && node --import tsx tests/reference.ts && node --import tsx tests/parity.ts && node --import tsx tests/packages.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "jszip": "^3.10.1",
    "plotly.js-dist-min": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webr": "0.6.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^8.3.3"
  }
}
