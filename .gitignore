node_modules/
dist/
r-packages/
src-tauri/target/
src-tauri/gen/
.DS_Store

# Linux dev/test run artefacts (logs, pid files, probe scripts)
logs/

# Vendored webR package repo (plan 00): build artefact, not source — it is
# 57 MB of .tgz files rebuilt by scripts/build-webr-repo.sh from the pinned
# manifest. Never commit it; a build without it falls back to the CDN.
webr-repo/

# QA notes (*.md, any depth) are tracked; all other QA artefacts
# (screenshots, logs, fixtures) stay uncommitted.
qa/**
!qa/**/
!qa/**/*.md
test-corpus/

# e2e (spike/tauri-e2e): temp outputs, scratch app-data dir, wdio logs.
e2e/out/
e2e/.e2e-home/
e2e/logs/
